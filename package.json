{
    "name": "moment",
    "version": "2.30.1",
    "description": "Parse, validate, manipulate, and display dates",
    "homepage": "https://momentjs.com",
    "keywords": [
        "moment",
        "date",
        "time",
        "i18n",
        "l10n"
    ],
    "main": "./moment.js",
    "jsnext:main": "./dist/moment.js",
    "typings": "./moment.d.ts",
    "files": [
        "dist/",
        "locale/",
        "min/locales.js",
        "min/locales.min.js",
        "min/locales.min.js.map",
        "min/moment-with-locales.js",
        "min/moment-with-locales.min.js",
        "min/moment-with-locales.min.js.map",
        "min/moment.min.js",
        "min/moment.min.js.map",
        "src/lib/",
        "src/locale/",
        "src/moment.js",
        "ts3.1-typings/",
        "CHANGELOG.md",
        "ender.js",
        "moment.d.ts",
        "moment.js",
        "dojo.profile.js"
    ],
    "typesVersions": {
        ">=3.1": {
            "*": [
                "ts3.1-typings/*"
            ],
            "min/moment-with-locales": [
                "ts3.1-typings/moment.d.ts"
            ]
        }
    },
    "engines": {
        "node": "*"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.13.0",
            "onFail": "error"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/moment/moment.git"
    },
    "bugs": {
        "url": "https://github.com/moment/moment/issues"
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^4.0.0",
        "benchmark": "^2.1.4",
        "eslint": "^10.8.1",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "rollup": "^4.62.4",
        "typescript": "^7.0.2",
        "typescript1": "npm:typescript@^1.8.10",
        "typescript2": "npm:typescript@^2.9.2",
        "typescript3": "npm:typescript@^3.9.10",
        "typescript3_0": "npm:typescript@3.0.3",
        "typescript3_1": "npm:typescript@3.1.6",
        "typescript4": "npm:typescript@^4.9.5",
        "typescript5": "npm:typescript@^5.9.3",
        "typescript6": "npm:typescript@^6.0.3",
        "uglify-js": "^3.19.3",
        "vitest": "^4.0.0"
    },
    "ender": "./ender.js",
    "dojoBuild": "dojo.profile.js",
    "jspm": {
        "files": [
            "moment.js",
            "moment.d.ts",
            "locale"
        ],
        "map": {
            "moment": "./moment"
        },
        "buildConfig": {
            "uglify": true
        }
    },
    "scripts": {
        "typescript-test": "npm run typescript-test:1 && npm run typescript-test:2 && npm run typescript-test:3.0 && npm run typescript-test:3.1 && npm run typescript-test:3.9 && npm run typescript-test:4 && npm run typescript-test:5 && npm run typescript-test:6 && npm run typescript-test:7",
        "typescript-test:1": "node node_modules/typescript1/lib/tsc.js --project typing-tests/legacy",
        "typescript-test:2": "node node_modules/typescript2/lib/tsc.js --project typing-tests/legacy --types empty --typeRoots typing-tests/legacy/types",
        "typescript-test:3.0": "node node_modules/typescript3_0/lib/tsc.js --project typing-tests/legacy --types empty --typeRoots typing-tests/legacy/types",
        "typescript-test:3.1": "node node_modules/typescript3_1/lib/tsc.js --project typing-tests/modern",
        "typescript-test:3.9": "node node_modules/typescript3/lib/tsc.js --project typing-tests/modern",
        "typescript-test:4": "node_modules/typescript4/bin/tsc --project typing-tests/modern",
        "typescript-test:5": "node_modules/typescript5/bin/tsc --project typing-tests/modern",
        "typescript-test:6": "node_modules/typescript6/bin/tsc --project typing-tests/modern",
        "typescript-test:7": "node_modules/typescript/bin/tsc --project typing-tests/modern",
        "test": "vitest run",
        "test:watch": "vitest",
        "build": "node scripts/build.js",
        "build:custom": "node scripts/build.js --locales",
        "update-index": "node scripts/update-index.js",
        "update-component": "node scripts/update-component.js",
        "minify": "node scripts/minify.js",
        "release": "npm run lint && npm test && npm run build && npm run update-index && npm run update-component && npm run minify",
        "benchmark": "node scripts/benchmark.js",
        "bump-version": "node scripts/bump-version.js",
        "validate": "npm run lint && npm test",
        "eslint": "eslint scripts src test",
        "lint": "npm run eslint && npm run prettier-check && node scripts/check-months-parse.js",
        "prettier-check": "prettier --check .",
        "prettier-fmt": "prettier --write .",
        "coverage": "vitest run --coverage"
    },
    "spm": {
        "main": "moment.js",
        "output": [
            "locale/*.js"
        ]
    }
}
