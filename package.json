{
    "name": "moment",
    "version": "2.30.1",
    "description": "Parse, validate, manipulate, and display dates",
    "homepage": "https://momentjs.com",
    "keywords": [
        "moment",
        "date",
        "time",
        "i18n",
        "l10n"
    ],
    "main": "./moment.js",
    "jsnext:main": "./dist/moment.js",
    "typings": "./moment.d.ts",
    "typesVersions": {
        ">=3.1": {
            "*": [
                "ts3.1-typings/*"
            ],
            "min/moment-with-locales": [
                "ts3.1-typings/moment.d.ts"
            ]
        }
    },
    "engines": {
        "node": "*"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.13.0",
            "onFail": "error"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/moment/moment.git"
    },
    "bugs": {
        "url": "https://github.com/moment/moment/issues"
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "17.0.21",
        "benchmark": "^2.1.4",
        "coveralls": "^3.1.1",
        "es6-promise": "^4.2.8",
        "eslint": "^10.8.1",
        "globals": "^17.11.0",
        "grunt": "^1.6.3",
        "grunt-benchmark": "^1.0.0",
        "grunt-cli": "^1.5.0",
        "grunt-contrib-clean": "^2.0.1",
        "grunt-contrib-concat": "^2.1.0",
        "grunt-contrib-copy": "^1.0.0",
        "grunt-contrib-uglify": "^5.2.2",
        "grunt-contrib-watch": "^1.1.0",
        "grunt-env": "^1.0.1",
        "grunt-exec": "^3.0.0",
        "grunt-karma": "^4.0.2",
        "grunt-nuget": "^0.3.1",
        "grunt-string-replace": "^1.3.3",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-firefox-launcher": "^2.1.3",
        "karma-qunit": "^4.2.1",
        "karma-sauce-launcher": "^4.3.6",
        "load-grunt-tasks": "^5.1.0",
        "lodash": "^4.18.1",
        "node-qunit": "^2.0.2",
        "nyc": "^18.0.0",
        "prettier": "^3.9.6",
        "qunit": "^2.26.0",
        "rollup": "^4.62.4",
        "typescript": "^1.8.10",
        "typescript3": "npm:typescript@^3.9.10",
        "uglify-js": "^3.19.3"
    },
    "ender": "./ender.js",
    "dojoBuild": "package.js",
    "jspm": {
        "files": [
            "moment.js",
            "moment.d.ts",
            "locale"
        ],
        "map": {
            "moment": "./moment"
        },
        "buildConfig": {
            "uglify": true
        }
    },
    "scripts": {
        "ts3.1-typescript-test": "cross-env node_modules/typescript3/bin/tsc --project ts3.1-typing-tests",
        "typescript-test": "cross-env node_modules/typescript/bin/tsc --project typing-tests",
        "test": "grunt test",
        "eslint": "eslint Gruntfile.js tasks src",
        "prettier-check": "prettier --check Gruntfile.js tasks src",
        "prettier-fmt": "prettier --write Gruntfile.js tasks src",
        "coverage": "nyc npm test && nyc report",
        "coveralls": "nyc npm test && nyc report --reporter=text-lcov | coveralls"
    },
    "spm": {
        "main": "moment.js",
        "output": [
            "locale/*.js"
        ]
    }
}
